{
  "manifest_version": 3,
  "name": "Habitica Time Ledger",
  "version": "0.5.1",
  "description": "Turn Habitica completions into activity blocks and colorful visual analytics.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "https://habitica.com/*",
    "https://*.habitica.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Habitica Time Ledger",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://habitica.com/*",
        "https://*.habitica.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
